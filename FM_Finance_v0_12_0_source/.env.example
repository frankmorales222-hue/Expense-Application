# F&M Finance configuration. Copy to .env in the same folder as FMExpenseTracker.exe.
# Never commit or email the real .env file.

# ---- Server ----
# 0.0.0.0 = reachable from other computers; 127.0.0.1 = this machine only.
APP_HOST=127.0.0.1
APP_PORT=8010
# "development" enables the API docs at /api/docs. Use "production" on the server.
APP_ENV=production

# ---- Database ----
# Local test default: file is created under data/ beside .env/the executable.
DATABASE_URL=sqlite:///data/fm_finance.db
# PostgreSQL alternative (transfer existing SQLite records before switching):
# DATABASE_URL=postgresql+psycopg2://fm_user:CHANGE_ME@localhost:5432/fm_finance

# ---- Login ----
# Long random string, 40+ characters. Changing it signs everyone out.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_HOURS=12
# Set to true once the app is served over HTTPS (e.g. behind IIS or Caddy).
COOKIE_SECURE=false
# Used only on first start, to create the admin account. Change the password in Settings afterwards.
ADMIN_EMAIL=admin@fmitai.com
ADMIN_NAME=Francisco Morales
ADMIN_INITIAL_PASSWORD=CHANGE_ME

# ---- First company (fresh install only; rename later in Settings) ----
COMPANY_NAME=My Company

# ---- Desktop mode ----
# true = an admin can stop the app from the sidebar ("Exit app"). Use for the portable EXE only.
DESKTOP_MODE=false

# ---- Bill import (v0.4.0) ----
# Offline reading (PDF/Word/email text + OCR for scans and photos) always runs first.
# AI_EXTRACTION: off | fallback (AI only when offline reading isn't confident) | always
# When AI is used, the bill is sent to Anthropic to be read.
AI_EXTRACTION=off
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OCR_ENABLED=true

# ---- Receipt storage ----
# auto  = MinIO when MINIO_ACCESS_KEY/SECRET are set, otherwise the local folder below
# local = always the local folder;  minio = always MinIO
RECEIPT_STORAGE=auto
RECEIPT_DIR=data/receipts

# ---- Full backups (portable Windows app, v0.11.0) ----
# Leave blank to use Documents\FM Finance Backups. This is intentionally outside the EXE folder.
# A full backup contains the database, .env settings and every local receipt.
BACKUP_DIR=

# ---- MinIO (optional) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET=expenses
MAX_RECEIPT_MB=10
# ---- Starting defaults for new companies (v0.10.0) ----
# Each company changes these for itself in Settings > Company rules; these only apply until it does.
CURRENCY=USD
# false = every expense is saved as approved. true = amounts at or above the threshold wait for approval.
APPROVAL_REQUIRED=false
DEFAULT_APPROVAL_THRESHOLD=500.00

# ---- Logging ----
# Relative paths are relative to the .exe folder.
LOG_DIR=logs

# Email through Microsoft 365 with "Connect Microsoft 365" (v0.7.1; works with MFA).
# Application (client) ID of an Entra app registration: multitenant, "Allow public client flows" on,
# delegated Microsoft Graph permissions Mail.Send and offline_access. Optional: owners can also paste
# it in Settings > Email instead.
MS_CLIENT_ID=
MS_TENANT=organizations
